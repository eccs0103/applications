{
	"$schema": "../../../node_modules/wrangler/config-schema.json",
	"name": "birthdays-push",
	"main": "controllers/birthday-push-worker.ts",
	"compatibility_date": "2026-07-16",
	"routes": [
		{ "pattern": "birthdays-push.eccs.dev", "custom_domain": true }
	],
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true
		}
	},
	"vars": {
		"VAPID_PUBLIC": "BJ4t906-1NfoxkahS8VUthT9-sKttCIjsWfCRVXVCUvWRNAgyYG1BegX3JF9j-SWm0LGY3w-eVQb8lddjVv0j0o"
	},
	"kv_namespaces": [
		{ "binding": "SUBSCRIPTIONS", "id": "d39b2d3be699468f89a0cb1987b0dccc" }
	],
	"triggers": {
		"crons": [ "0 8 * * *" ]
	},
	"secrets": {
		"required": [ "VAPID_PRIVATE", "TRIGGER_SECRET" ]
	}
}
